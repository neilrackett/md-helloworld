{
  "version": "0.2.0",
  "configurations": [
    {
      // Modify the name to your project name
      "name": "Hello, Debug!",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.launchTargetPath}",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      // Dynamic GDB path based on environment variable
      "gdbPath": "${env:ARM_GDB_PATH}/bin/arm-none-eabi-gdb",
      "device": "RP2040",
      "configFiles": ["interface/cmsis-dap.cfg", "target/rp2040.cfg"],
      "serverArgs": ["-c", "adapter speed 1000"],
      "svdFile": "./pico-sdk/src/rp2040/hardware_regs/rp2040.svd",
      "runToEntryPoint": "main",
      "postRestartCommands": ["set remotetimeout 10"],
      "postLaunchCommands": ["set remotetimeout 10"],
      "searchDir": [
        // OpenOCD scripts directory (contains interface/*.cfg and target/*.cfg)
        "/usr/share/openocd/scripts"
      ],
      "showDevDebugOutput": "raw",
      "liveWatch": {
        "enabled": false
      }
    },
    {
      // Attach without re-flashing to observe runtime behavior without launch resets
      "name": "Hello, Attach (No Reset)!",
      "cwd": "${workspaceFolder}",
      "executable": "${command:cmake.launchTargetPath}",
      "request": "attach",
      "type": "cortex-debug",
      "servertype": "openocd",
      "gdbPath": "${env:ARM_GDB_PATH}/bin/arm-none-eabi-gdb",
      "device": "RP2040",
      "configFiles": ["interface/cmsis-dap.cfg", "target/rp2040.cfg"],
      "serverArgs": ["-c", "adapter speed 1000"],
      "svdFile": "./pico-sdk/src/rp2040/hardware_regs/rp2040.svd",
      "postAttachCommands": [
        "set remotetimeout 10",
        "continue"
      ],
      "searchDir": ["/usr/share/openocd/scripts"],
      "showDevDebugOutput": "raw",
      "liveWatch": {
        "enabled": false
      }
    }
  ]
}
